# Second example app: pub.dev only renders example/, so this just duplicates assets.
example_web/

# Example sample images: not declared as runtime assets (only assets/models is).
example/assets/

# Demo videos used only by the example app, not loaded by the package at runtime.
sample_videos/

# Example Podfile (gitignored; not needed in the published tarball).
example/**/Podfile
example/**/Podfile.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Screenshots (referenced via GitHub URLs in README)
assets/screenshots/

# Package tests and dev scripts: not needed by consumers of the published archive
test/
android/src/test/
windows/test/
linux/test/
runAllTests.sh
runBenchmark.sh
runWebBenchmark.sh
scripts.txt

# Example app: keep example/lib and example/pubspec.yaml (pub.dev Example tab and pana),
# exclude runner scaffolding and tests, which only matter when cloning from GitHub
example/android/
example/ios/
example/macos/
example/windows/
example/linux/
example/web/
example/integration_test/
example/test_driver/
